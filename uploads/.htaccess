# Never execute code from the uploads folder, and do not list it.
# (Avoids php_flag, which some shared hosts reject with a 500 error.)
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|phar|pl|py|cgi|asp|aspx|sh|exe|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
